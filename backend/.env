# AI Recruitment Intelligence Platform - Environment Variables

# LLM Provider Configuration
# Supported: gemini, openai, ollama (initially gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6Lvh76ZVG5x61EcdlseFVGgt6Yrdn9ivTTkSsiA84Z-8A

# OPENAI_API_KEY=

# Embedding Configuration
# Supported: sentence-transformers, openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Database Configuration
DATABASE_URL=sqlite:///./recruitment.db

# Storage & Paths Configuration
# Paths can be absolute or relative to the backend/app directory
UPLOAD_DIR=./uploads
EXCEL_PATH=./excel/Candidates.xlsx
VECTOR_PATH=./vectors

# Matching Thresholds
SIMILARITY_THRESHOLD=0.5

# CORS Configuration for Vercel Deployment
# Example: FRONTEND_URL=https://your-vercel-app.vercel.app
FRONTEND_URL=https://resume-parser-2wl1.onrender.com/
